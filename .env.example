# cp .env.example .env
# Quote values that contain #, $ or spaces.

# Local signing key. Keep the quotes: # and $ break an unquoted value.
SECRET_KEY='change-me-to-a-long-random-string'

# true, 1 or yes. Set to False to see the custom 404 page.
DEBUG=True

# Comma-separated. Empty only while DEBUG=True.
ALLOWED_HOSTS=localhost,127.0.0.1
